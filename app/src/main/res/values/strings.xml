    <string name="app_name">Hop</string>

    <string name="onboarding_title">Hop</string>
    <string name="onboarding_tagline">The floor stays up when the tower doesn\'t.</string>
    <string name="onboarding_body">Asks, offers, and notes hop between phones on this hostel floor. No login. This build uses fake posts so you can feel the app without a radio.</string>
    <string name="onboarding_floor_title">Floor</string>
    <string name="onboarding_floor_body">Asks, offers, and notes sit on this corridor. Offer and Ask cards keep a thin leading edge.</string>
    <string name="onboarding_nearby_title">Nearby</string>
    <string name="onboarding_nearby_body">A quiet count of phones in range. Not a banner. Not a mesh status scream.</string>
    <string name="onboarding_cut_title">Cut</string>
    <string name="onboarding_cut_body">When the lights die, the clock stays. True black, a small flame-cap, no bloom.</string>
    <string name="onboarding_cta">Join</string>
    <string name="onboarding_footnote">Demo data only. Bluetooth and mesh are not in this build.</string>

